    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Metropolis)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Marketplace/bin/Release/net10.0/Marketplace.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Marketplace",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
